!------------------------------------------------------------------------------
! SECTION 9.11 - DISPATCHER PROCESS / PROCESS DISPATCHER
!------------------------------------------------------------------------------
!
! FR:
!   Le dispatcher constitue l'unique point de correspondance entre un
!   identifiant process et son implementation RAPID.
!
!   Pour ajouter un process :
!
!       1. ajouter sa constante dans la section 5 ;
!       2. l'ajouter au tableau processTypes ;
!       3. creer ses routines Begin, BeforeMotion, AfterMotion, End et Abort ;
!       4. ajouter un CASE dans chacun des dispatchers ci-dessous ;
!       5. mettre a jour le client Python, les tests et la documentation.
!
!   Le process NONE est un cas normal. Ses hooks ne realisent aucune action.
!
! EN:
!   The dispatcher is the single mapping point between a process identifier
!   and its RAPID implementation.
!
!   To add a process:
!
!       1. add its constant in section 5;
!       2. add it to the processTypes array;
!       3. create its Begin, BeforeMotion, AfterMotion, End and Abort routines;
!       4. add a CASE to each dispatcher below;
!       5. update the Python client, tests and documentation.
!
!   The NONE process is a normal case. Its hooks perform no action.
!------------------------------------------------------------------------------


    PROC TRAJCENTER_ProcessBegin(num processType)

        TEST processType

        CASE processNone:
            RETURN;

        CASE processAcf:
            TRAJCENTER_AcfBegin;

        CASE processAak:
            TRAJCENTER_AakBegin;

        CASE processPushcorp:
            TRAJCENTER_PushcorpBegin;

        DEFAULT:
            RAISE ERR_TJC_BAD_PROCESS_TYPE;

        ENDTEST

    ENDPROC


    PROC TRAJCENTER_ProcessBeforeMotion(
        num processType,
        num pointIndex
    )

        TEST processType

        CASE processNone:
            RETURN;

        CASE processAcf:
            TRAJCENTER_AcfBeforeMotion pointIndex;

        CASE processAak:
            TRAJCENTER_AakBeforeMotion pointIndex;

        CASE processPushcorp:
            TRAJCENTER_PushcorpBeforeMotion pointIndex;

        DEFAULT:
            RAISE ERR_TJC_BAD_PROCESS_TYPE;

        ENDTEST

    ENDPROC


    PROC TRAJCENTER_ProcessAfterMotion(
        num processType,
        num pointIndex
    )

        TEST processType

        CASE processNone:
            RETURN;

        CASE processAcf:
            TRAJCENTER_AcfAfterMotion pointIndex;

        CASE processAak:
            TRAJCENTER_AakAfterMotion pointIndex;

        CASE processPushcorp:
            TRAJCENTER_PushcorpAfterMotion pointIndex;

        DEFAULT:
            RAISE ERR_TJC_BAD_PROCESS_TYPE;

        ENDTEST

    ENDPROC


    PROC TRAJCENTER_ProcessEnd(num processType)

        TEST processType

        CASE processNone:
            RETURN;

        CASE processAcf:
            TRAJCENTER_AcfEnd;

        CASE processAak:
            TRAJCENTER_AakEnd;

        CASE processPushcorp:
            TRAJCENTER_PushcorpEnd;

        DEFAULT:
            RAISE ERR_TJC_BAD_PROCESS_TYPE;

        ENDTEST

    ENDPROC


    !--------------------------------------------------------------------------
    ! FR:
    !   Tente de remettre le process dans un etat sur.
    !
    !   Les routines appelees ici doivent eviter de lever une erreur afin de ne
    !   pas masquer l'erreur d'execution originale.
    !
    ! EN:
    !   Attempts to return the process to a safe state.
    !
    !   Routines called here should avoid raising an error so that the original
    !   execution error is not hidden.
    !--------------------------------------------------------------------------
    PROC TRAJCENTER_ProcessAbort(num processType)

        TEST processType

        CASE processNone:
            RETURN;

        CASE processAcf:
            TRAJCENTER_AcfAbort;

        CASE processAak:
            TRAJCENTER_AakAbort;

        CASE processPushcorp:
            TRAJCENTER_PushcorpAbort;

        DEFAULT:
            RETURN;

        ENDTEST

    ENDPROC


!------------------------------------------------------------------------------
! SECTION 9.12 - MOTEUR DE MOUVEMENT COMMUN / COMMON MOTION ENGINE
!------------------------------------------------------------------------------
!
! FR:
!   Cette section contient l'unique implementation generique des mouvements.
!
!   Elle prend en charge :
!       - la lecture des points ;
!       - la construction du speeddata ;
!       - la conversion de la zone ;
!       - le chargement du tool et du workobject ;
!       - l'application de readConfs ;
!       - la validation des paires MoveC ;
!       - les appels process avant et apres chaque mouvement ;
!       - l'increment de l'index de parcours.
!
!   L'index pointIndex est passe par reference et est avance :
!       - de 1 apres MoveL ou MoveJ ;
!       - de 2 apres MoveC.
!
! EN:
!   This section contains the single generic motion implementation.
!
!   It handles:
!       - point reading;
!       - speeddata construction;
!       - zone conversion;
!       - tool and workobject loading;
!       - readConfs application;
!       - MoveC pair validation;
!       - process calls before and after each motion;
!       - traversal index update.
!
!   pointIndex is passed by reference and advanced:
!       - by 1 after MoveL or MoveJ;
!       - by 2 after MoveC.
!------------------------------------------------------------------------------


    PROC TRAJCENTER_ExecuteOneMotion(
        VAR num pointIndex,
        num processType,
        num oriSpeed,
        num leaxSpeed,
        num reaxSpeed
    )
        VAR num currentIndex;
        VAR trajCenterPointData p;
        VAR trajCenterPointData p2;
        VAR speeddata v;
        VAR zonedata z;

        IF pointIndex < 1 OR pointIndex > nbLoadedTrajPoints THEN
            RAISE ERR_TJC_BAD_POINT_INDEX;
        ENDIF

        currentIndex := pointIndex;
        p := trajData{currentIndex};

        v := TRAJCENTER_MakeSpeed(
            p.tcpSpeed,
            oriSpeed,
            leaxSpeed,
            reaxSpeed
        );

        z := TRAJCENTER_MakeZone(p.zoneType);

        TRAJCENTER_LoadExecTool p.toolIndex;
        TRAJCENTER_LoadExecWobj p.wobjIndex;
        TRAJCENTER_ApplyReadConfs p.readConfs;


        IF p.moveType = moveTypeL THEN

            TRAJCENTER_ProcessBeforeMotion
                processType,
                currentIndex;

            MoveL
                p.point,
                v,
                z,
                trajExecTool
                \WObj:=trajExecWobj;

            TRAJCENTER_ProcessAfterMotion
                processType,
                currentIndex;

            pointIndex := currentIndex + 1;


        ELSEIF p.moveType = moveTypeJ THEN

            TRAJCENTER_ProcessBeforeMotion
                processType,
                currentIndex;

            MoveJ
                p.point,
                v,
                z,
                trajExecTool
                \WObj:=trajExecWobj;

            TRAJCENTER_ProcessAfterMotion
                processType,
                currentIndex;

            pointIndex := currentIndex + 1;


        ELSEIF p.moveType = moveTypeC THEN

            IF currentIndex + 1 > nbLoadedTrajPoints THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            p2 := trajData{currentIndex + 1};

            IF p2.moveType <> moveTypeC THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.tcpSpeed <> p.tcpSpeed THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.toolIndex <> p.toolIndex THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.wobjIndex <> p.wobjIndex THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.zoneType <> p.zoneType THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.readConfs <> p.readConfs THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            IF p2.processParamIndex <> p.processParamIndex THEN
                RAISE ERR_TJC_BAD_MOVEC_PAIR;
            ENDIF

            TRAJCENTER_ProcessBeforeMotion
                processType,
                currentIndex;

            MoveC
                p.point,
                p2.point,
                v,
                z,
                trajExecTool
                \WObj:=trajExecWobj;

            TRAJCENTER_ProcessAfterMotion
                processType,
                currentIndex;

            pointIndex := currentIndex + 2;


        ELSE

            RAISE ERR_TJC_BAD_MOVE_TYPE;

        ENDIF

    ENDPROC


!------------------------------------------------------------------------------
! SECTION 9.13 - API PUBLIQUE D'EXECUTION / PUBLIC EXECUTION API
!------------------------------------------------------------------------------
!
! FR:
!   TRAJCENTER_ExecuteLoaded est l'unique point d'entree public recommande pour
!   executer une trajectoire chargee.
!
!   Le process NONE n'utilise aucune action process. Il passe neanmoins par le
!   meme moteur de mouvement que les autres process.
!
!   En cas d'erreur :
!       - le process est arrete par ProcessAbort ;
!       - ConfL et ConfJ sont remis a On ;
!       - l'erreur originale est propagee au programme appelant.
!
! EN:
!   TRAJCENTER_ExecuteLoaded is the single recommended public entry point for
!   executing a loaded trajectory.
!
!   The NONE process performs no process action. It still uses the same motion
!   engine as all other processes.
!
!   On error:
!       - the process is stopped through ProcessAbort;
!       - ConfL and ConfJ are restored to On;
!       - the original error is propagated to the calling program.
!------------------------------------------------------------------------------


    PROC TRAJCENTER_ExecuteLoaded(
        num oriSpeed,
        num leaxSpeed,
        num reaxSpeed
    )
        VAR num pointIndex;
        VAR num activeProcessType;

        activeProcessType := processNone;
        pointIndex := 1;

        IF trajReady = FALSE THEN
            RAISE ERR_TJC_NOT_READY;
        ENDIF

        IF nbLoadedTrajPoints < 1 OR
            nbLoadedTrajPoints > maxTrajPointCount THEN
                RAISE ERR_TJC_NOT_READY;
        ENDIF

        activeProcessType := loadedProcessType;

        TRAJCENTER_ProcessBegin activeProcessType;

        WHILE pointIndex <= nbLoadedTrajPoints DO

            TRAJCENTER_ExecuteOneMotion
                pointIndex,
                activeProcessType,
                oriSpeed,
                leaxSpeed,
                reaxSpeed;

        ENDWHILE

        TRAJCENTER_ProcessEnd activeProcessType;

        ConfL \On;
        ConfJ \On;

        RETURN;


    ERROR

        TRAJCENTER_ProcessAbort activeProcessType;

        ConfL \On;
        ConfJ \On;

        RAISE;

    ENDPROC


ENDMODULE

