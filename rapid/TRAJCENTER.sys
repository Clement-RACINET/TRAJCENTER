!==============================================================================
! SECTION 7 - VARIABLES RWS / RWS EXCHANGE VARIABLES
!==============================================================================
!
! FR:
!   Variables d'�change ABB Robot Web Services.
!
!   Les flags de requ�te sont PERS afin de permettre l'abonnement RWS c�t� PC.
!   Les autres variables sont VAR car elles repr�sentent un �tat runtime.
!
!   Le PC doit �crire ces variables sous Mastership.
!   Les �v�nements FALSE sur les flags de requ�te doivent �tre ignor�s c�t� PC.
!
! EN:
!   ABB Robot Web Services exchange variables.
!
!   Request flags are PERS to allow PC-side RWS subscription.
!   Other variables are VAR because they represent runtime state.
!
!   The PC must write these variables under Mastership.
!   FALSE events on request flags must be ignored by the PC.
!==============================================================================


!------------------------------------------------------------------------------
! SECTION 7.1 - FLAGS DE REQUETE / REQUEST FLAGS
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Demande de chargement trajectoire depuis le PC.
    !
    !   S�quence c�t� robot :
    !       selectedTrajIndex := k;
    !       sendTrajRequest := TRUE;
    !
    !   Comportement c�t� PC :
    !       1. Recevoir l'�v�nement TRUE via abonnement RWS.
    !       2. Lire selectedTrajIndex.
    !       3. Charger le fichier .trajcenter correspondant.
    !       4. Lire les variables par defaut, tools, wobjs et processTypes.
    !       5. R�soudre les champs robot.
    !       6. �crire nbLoadedTrajPoints, processParams et trajData.
    !       7. �crire les variables d'�tat.
    !       8. Remettre sendTrajRequest � FALSE.
    !
    ! EN:
    !   Request trajectory loading from the PC.
    !
    !   Robot-side sequence:
    !       selectedTrajIndex := k;
    !       sendTrajRequest := TRUE;
    !
    !   PC-side behavior:
    !       1. Receive the TRUE event through RWS subscription.
    !       2. Read selectedTrajIndex.
    !       3. Load the corresponding .trajcenter file.
    !       4. Read defaults, tools, wobjs and processTypes.
    !       5. Resolve robot-side fields.
    !       6. Write nbLoadedTrajPoints, processParams and trajData.
    !       7. Write status variables.
    !       8. Reset sendTrajRequest to FALSE.
    !--------------------------------------------------------------------------
    PERS bool sendTrajRequest := FALSE;


    !--------------------------------------------------------------------------
    ! FR:
    !   Demande de rafra�chissement metadata depuis le PC.
    !
    !   S�quence c�t� robot :
    !       refreshMetaRequest := TRUE;
    !
    !   Comportement c�t� PC :
    !       1. Recevoir l'�v�nement TRUE via abonnement RWS.
    !       2. Scanner le store trajectoire PC.
    !       3. Lister les fichiers .trajcenter exportables.
    !       4. �crire nbTrajAvailable et trajectories.
    !       5. �crire les variables d'�tat.
    !       6. Remettre refreshMetaRequest � FALSE.
    !
    ! EN:
    !   Request metadata refresh from the PC.
    !
    !   Robot-side sequence:
    !       refreshMetaRequest := TRUE;
    !
    !   PC-side behavior:
    !       1. Receive the TRUE event through RWS subscription.
    !       2. Scan the PC trajectory store.
    !       3. List exportable .trajcenter files.
    !       4. Write nbTrajAvailable and trajectories.
    !       5. Write status variables.
    !       6. Reset refreshMetaRequest to FALSE.
    !--------------------------------------------------------------------------
    PERS bool refreshMetaRequest := FALSE;


!------------------------------------------------------------------------------
! SECTION 7.2 - CONTEXTE DE REQUETE / REQUEST CONTEXT
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Index de la trajectoire s�lectionn�e.
    !
    !   Convention :
    !       0 = aucune trajectoire s�lectionn�e.
    !       1..nbTrajAvailable = index valide dans trajectories.
    !
    ! EN:
    !   Selected trajectory index.
    !
    !   Convention:
    !       0 = no selected trajectory.
    !       1..nbTrajAvailable = valid index in trajectories.
    !--------------------------------------------------------------------------
    VAR num selectedTrajIndex := 0;


!------------------------------------------------------------------------------
! SECTION 7.3 - ETAT OPERATIONNEL / OPERATION STATUS
!------------------------------------------------------------------------------

    ! FR: TRUE uniquement lorsque trajData est complet et ex�cutable.
    ! EN: TRUE only when trajData is complete and executable.
    VAR bool trajReady := FALSE;

    ! FR: TRUE lorsque le dernier refresh ou transfert a �chou�.
    ! EN: TRUE when the latest refresh or transfer failed.
    VAR bool transferError := FALSE;

    ! FR: Dernier code d'�tat ou d'erreur �crit par le PC.
    ! EN: Last status or error code written by the PC.
    VAR num lastErrorCode := statusOk;

    ! FR: Message court associ� au dernier �tat ou � la derni�re erreur.
    ! EN: Short message associated with the latest status or error.
    VAR string lastError := "";

    ! FR: Progression transfert en pourcentage, de 0 � 100.
    ! EN: Transfer progress in percent, from 0 to 100.
    VAR num transferProgress := 0;


!------------------------------------------------------------------------------
! SECTION 7.4 - METADONNEES TRAJECTOIRES / TRAJECTORY METADATA
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Nombre d'entr�es valides dans trajectories.
    !
    !   Plage valide :
    !       0..256
    !
    !   Entr�es valides :
    !       trajectories{1..nbTrajAvailable}
    !
    ! EN:
    !   Number of valid entries in trajectories.
    !
    !   Valid range:
    !       0..256
    !
    !   Valid entries:
    !       trajectories{1..nbTrajAvailable}
    !--------------------------------------------------------------------------
    VAR num nbTrajAvailable := 0;


    !--------------------------------------------------------------------------
    ! FR:
    !   M�tadonn�es des trajectoires disponibles dans le store PC.
    !
    !   Champs :
    !       trajectories{i}.name        = nom affichable
    !       trajectories{i}.pointCount  = nombre de points
    !       trajectories{i}.processType = type process
    !
    ! EN:
    !   Metadata of trajectories available in the PC store.
    !
    !   Fields:
    !       trajectories{i}.name        = display name
    !       trajectories{i}.pointCount  = number of points
    !       trajectories{i}.processType = process type
    !--------------------------------------------------------------------------
    VAR trajCenterTrajMeta trajectories{256};


!------------------------------------------------------------------------------
! SECTION 7.5 - TRAJECTOIRE CHARGEE / LOADED TRAJECTORY
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Nombre d'entr�es valides dans trajData pour la trajectoire charg�e.
    !
    !   Les routines d'ex�cution RAPID doivent parcourir :
    !       FOR i FROM 1 TO nbLoadedTrajPoints DO
    !           ...
    !       ENDFOR
    !
    ! EN:
    !   Number of valid entries in trajData for the loaded trajectory.
    !
    !   RAPID execution routines must iterate over:
    !       FOR i FROM 1 TO nbLoadedTrajPoints DO
    !           ...
    !       ENDFOR
    !--------------------------------------------------------------------------
    VAR num nbLoadedTrajPoints := 0;


    !--------------------------------------------------------------------------
    ! FR:
    !   Donn�es de la trajectoire charg�e par le PC.
    !
    !   Entr�es valides :
    !       trajData{1..nbLoadedTrajPoints}
    !
    ! EN:
    !   Trajectory data loaded by the PC.
    !
    !   Valid entries:
    !       trajData{1..nbLoadedTrajPoints}
    !--------------------------------------------------------------------------
    VAR trajCenterPointData trajData{100000};


    !--------------------------------------------------------------------------
    ! FR:
    !   Table des param�tres process �crite par le PC.
    !
    !   Premi�re dimension :
    !       index du jeu de param�tres process, 1..256.
    !
    !   Deuxi�me dimension :
    !       slot de param�tre, 1..10.
    !
    !   Convention :
    !       processParams{i,j}.name = "" signifie slot inutilis�.
    !
    !   Mapping point :
    !       trajData{k}.processParamIndex = 0
    !           aucun param�tre process pour le point k.
    !
    !       trajData{k}.processParamIndex = p
    !           les param�tres process sont processParams{p,1..10}.
    !
    ! EN:
    !   Process parameter table written by the PC.
    !
    !   First dimension:
    !       process parameter set index, 1..256.
    !
    !   Second dimension:
    !       parameter slot, 1..10.
    !
    !   Convention:
    !       processParams{i,j}.name = "" means unused slot.
    !
    !   Point mapping:
    !       trajData{k}.processParamIndex = 0
    !           no process parameters for point k.
    !
    !       trajData{k}.processParamIndex = p
    !           process parameters are processParams{p,1..10}.
    !--------------------------------------------------------------------------
    VAR trajCenterProcessParameter processParams{256,10};


!==============================================================================
! SECTION 8 - VARIABLES PAR DEFAUT DU ROBOT / ROBOT DEFAULTS
!==============================================================================
!
! FR:
!   Valeurs par d�faut lues par le PC avant transfert trajectoire.
!
!   Ces variables font partie du protocole RWS, mais sont isol�es ici car elles
!   sont typiquement r�gl�es � la mise en service cellule.
!
!   Le PC ne doit jamais inventer silencieusement tool, wobj, speed ou zone.
!   Un fallback n'est autoris� que si le flag hasDefault* correspondant vaut
!   TRUE.
!
! EN:
!   Default values read by the PC before trajectory transfer.
!
!   These variables are part of the RWS protocol, but are isolated here because
!   they are typically configured during cell commissioning.
!
!   The PC must never silently invent tool, wobj, speed or zone values.
!   A fallback is allowed only if the corresponding hasDefault* flag is TRUE.
!==============================================================================


!------------------------------------------------------------------------------
! SECTION 8.1 - DEFAULT TCP SPEED / VITESSE TCP PAR DEFAUT
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Indique si une vitesse TCP par d�faut est disponible c�t� robot.
    !
    !   Si hasDefaultTcpSpeed = FALSE et que tcp_speed est absent du fichier
    !   .trajcenter, le PC doit refuser le transfert.
    !
    ! EN:
    !   Indicates whether a default TCP speed is available on the robot side.
    !
    !   If hasDefaultTcpSpeed = FALSE and tcp_speed is missing from the
    !   .trajcenter file, the PC must refuse the transfer.
    !--------------------------------------------------------------------------
    VAR bool hasDefaultTcpSpeed := FALSE;


    !--------------------------------------------------------------------------
    ! FR:
    !   Vitesse TCP par d�faut en mm/s.
    !   Utilis�e uniquement si hasDefaultTcpSpeed = TRUE.
    !
    ! EN:
    !   Default TCP speed in mm/s.
    !   Used only if hasDefaultTcpSpeed = TRUE.
    !--------------------------------------------------------------------------
    VAR num defaultTcpSpeed := 0;


!------------------------------------------------------------------------------
! SECTION 8.2 - DEFAULT ZONE / ZONE PAR DEFAUT
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Indique si une zone par d�faut est disponible c�t� robot.
    !
    !   Si hasDefaultZoneType = FALSE et que zone_type est absent du fichier
    !   .trajcenter, le PC doit refuser le transfert.
    !
    ! EN:
    !   Indicates whether a default zone is available on the robot side.
    !
    !   If hasDefaultZoneType = FALSE and zone_type is missing from the
    !   .trajcenter file, the PC must refuse the transfer.
    !--------------------------------------------------------------------------
    VAR bool hasDefaultZoneType := FALSE;


    !--------------------------------------------------------------------------
    ! FR:
    !   Zone par d�faut.
    !
    !   Utilis�e uniquement si hasDefaultZoneType = TRUE.
    !
    !   Valeurs autoris�es :
    !       0, 1, 5, 10, 15, 20, 30, 40, 50, 60,
    !       80, 100, 150, 200, 255.
    !
    ! EN:
    !   Default zone.
    !
    !   Used only if hasDefaultZoneType = TRUE.
    !
    !   Allowed values:
    !       0, 1, 5, 10, 15, 20, 30, 40, 50, 60,
    !       80, 100, 150, 200, 255.
    !--------------------------------------------------------------------------
    VAR num defaultZoneType := 255;


!------------------------------------------------------------------------------
! SECTION 8.3 - DEFAULT TOOL / TOOL PAR DEFAUT
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Indique si un nom de tool par d�faut est disponible c�t� robot.
    !
    !   Si hasDefaultToolName = FALSE et que tool_name est absent du fichier
    !   .trajcenter, le PC doit refuser le transfert.
    !
    !   Si hasDefaultToolName = TRUE, defaultToolName doit exister dans
    !   trajTools.
    !
    ! EN:
    !   Indicates whether a default tool name is available on the robot side.
    !
    !   If hasDefaultToolName = FALSE and tool_name is missing from the
    !   .trajcenter file, the PC must refuse the transfer.
    !
    !   If hasDefaultToolName = TRUE, defaultToolName must exist in trajTools.
    !--------------------------------------------------------------------------
    VAR bool hasDefaultToolName := FALSE;


    !--------------------------------------------------------------------------
    ! FR:
    !   Nom du tool par d�faut.
    !
    !   Ce n'est pas un tooldata.
    !   Le PC r�sout ce nom dans trajTools pour obtenir un toolIndex.
    !
    ! EN:
