# ==============================================================================
# TrajCenter v2.0 - Example environment file
# ==============================================================================
# Copy this file to ".env" and adapt values to your robot/controller.
#
# This file is loaded by:
#   scripts/run_rws_supervisor.py
#
# The supervisor uses ABB Robot Web Services (RWS), not the old TCP v1 server.
# Do not configure port 50000 here.
# ==============================================================================


# ==============================================================================
# ABB RWS CONTROLLER CONNECTION
# ==============================================================================

# ABB controller IP address or hostname.
# Common values:
#   - Real IRC5 controller on service port: 192.168.125.1
#   - RobotStudio virtual controller: depends on your VC/network setup
RWS_HOST=192.168.125.1

# ABB RWS HTTP port.
# RobotWare 6 RWS commonly uses HTTP port 80.
RWS_PORT=80

# Use HTTP for RW6 IRC5 unless your controller is explicitly configured for HTTPS.
RWS_SCHEME=http

# ABB RWS username.
# Default RobotWare user is often "Default User".
# Keep quotes if the username contains a space.
RWS_USERNAME="Default User"

# ABB RWS password.
# Default lab/demo password is often "robotics", but adapt to your controller.
RWS_PASSWORD=robotics

# Optional request timeout in seconds.
RWS_TIMEOUT=10.0


# ==============================================================================
# TRAJCENTER RAPID TARGET
# ==============================================================================

# RAPID task containing the TrajCenter RWS variables.
# Default expected task is usually T_ROB1.
TRAJCENTER_RWS_TASK=T_ROB1

# RAPID module containing:
#   - refreshMetaRequest
#   - sendTrajRequest
#   - selectedTrajIndex
#   - trajectories
#   - trajData
#   - processParams
#   - status variables
TRAJCENTER_RWS_MODULE=TRAJCENTER_WebServices


# ==============================================================================
# TRAJCENTER LOCAL STORE
# ==============================================================================

# Directory containing local .trajcenter archives.
# The current supervisor script expects this as CLI argument:
#
#   pixi run python scripts/run_rws_supervisor.py --store trajectory_store
#
# This variable is kept for clarity and future compatibility.
TRAJCENTER_STORE_ROOT=trajectory_store


# ==============================================================================
# SUPERVISOR BEHAVIOR
# ==============================================================================

# Number of retry attempts when acquiring ABB Mastership for RAPID writes.
TRAJCENTER_MASTERSHIP_RETRIES=3

# Logging level.
# Allowed values:
#   DEBUG
#   INFO
#   WARNING
#   ERROR
#   CRITICAL
TRAJCENTER_LOG_LEVEL=INFO


# ==============================================================================
# DEVELOPMENT / DEBUG
# ==============================================================================

# Enable verbose HTTP/RWS diagnostics if supported by the client stack.
# Recommended value for normal use: false
RWS_DEBUG=false

# Do not enable old TrajCenter v1 TCP mode.
# TrajCenter v2.0 uses RWS subscriptions only.
TRAJCENTER_USE_LEGACY_TCP=false
