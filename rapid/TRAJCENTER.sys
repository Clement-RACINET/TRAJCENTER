    !--------------------------------------------------------------------------
    VAR string defaultToolName := "";


!------------------------------------------------------------------------------
! SECTION 8.4 - DEFAULT WORKOBJECT / WORKOBJECT PAR DEFAUT
!------------------------------------------------------------------------------

    !--------------------------------------------------------------------------
    ! FR:
    !   Indique si un nom de workobject par d�faut est disponible c�t� robot.
    !
    !   Si hasDefaultWobjName = FALSE et que wobj_name est absent du fichier
    !   .trajcenter, le PC doit refuser le transfert.
    !
    !   Si hasDefaultWobjName = TRUE, defaultWobjName doit exister dans
    !   trajWobjs.
    !
    ! EN:
    !   Indicates whether a default workobject name is available on the robot
    !   side.
    !
    !   If hasDefaultWobjName = FALSE and wobj_name is missing from the
    !   .trajcenter file, the PC must refuse the transfer.
    !
    !   If hasDefaultWobjName = TRUE, defaultWobjName must exist in trajWobjs.
    !--------------------------------------------------------------------------
    VAR bool hasDefaultWobjName := FALSE;


    !--------------------------------------------------------------------------
    ! FR:
    !   Nom du workobject par d�faut.
    !
    !   Ce n'est pas un wobjdata.
    !   Le PC r�sout ce nom dans trajWobjs pour obtenir un wobjIndex.
    !
    ! EN:
    !   Default workobject name.
    !
    !   This is not a wobjdata.
